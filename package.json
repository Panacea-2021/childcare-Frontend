{
  "name": "childcare-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:wasm": "node -e \"process.env.FORCE_NEXT_WASM='1';process.env.NEXT_NO_TURBO='1';require('./scripts/dev.js')\"",
    "build": "node scripts/build.js",
    "start": "next start -p 3001",
    "predev": "node scripts/ensure-local-deps.js",
    "fix:onedrive-deps": "node scripts/fix-onedrive-deps.js",
    "postinstall": "node scripts/ensure-local-deps.js",
    "test:billing-schedule": "npx --yes tsx scripts/test-billing-schedule.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.7.1",
    "@react-pdf/renderer": "^4.6.0",
    "framer-motion": "^12.43.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "next": "^15.5.22",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.84.0",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.8.2"
  },
  "optionalDependencies": {
    "@next/swc-wasm-nodejs": "^15.5.22"
  }
}
